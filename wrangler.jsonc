{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kore-veridian",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "vars": {
    "CONTACT_TO_EMAIL": "contact@koreveridian.ca",
    "CONTACT_FROM_EMAIL": "Kore Veridian <contact@koreveridian.ca>",
    "SMTP_HOST": "mail.privateemail.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "contact@koreveridian.ca",
    "ENVIRONMENT": "production"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "koreveridian.ca",
      "custom_domain": true
    },
    {
      "pattern": "www.koreveridian.ca",
      "custom_domain": true
    }
  ]
}
